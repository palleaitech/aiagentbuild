# Import LLM wrappers for OpenAI and Google Gemini
import json

from langchain_openai import ChatOpenAI
from langchain_google_genai  import ChatGoogleGenerativeAI

# Load environment variables from a .env file
from dotenv import load_dotenv
import os

# Import LangGraph components for building stateful workflows
from langgraph.graph import StateGraph, START, END

from langchain_core.prompts import ChatPromptTemplate

# TypedDict lets us define a structured dictionary for state
from typing import TypedDict
from pydantic import BaseModel, Field

# Load environment variables (like API keys) from .env file
load_dotenv()

# Fetch the OpenAI API key from environment variables
api_key = os.getenv("OPENAI_API_KEY")

# Safety check: if no API key is found, raise an error
if not api_key:
    raise ValueError("OPENAI_API_KEY is not set in the environment variables.") 

# Initialize OpenAI LLM with chosen model and temperature
llm_openai = ChatOpenAI(model_name="gpt-4o", temperature=0.7, openai_api_key=api_key)

# -------------------------------
# PromptManager
# -------------------------------
class PromptManager:
  def __init__(self):
      self.prompts = {
          "support system": ChatPromptTemplate.from_messages([
              ("system", "You are a helpful support agent. Return JSON with keys: steps, notes."),
              ("human", "{question}")
          ]),
          "travel_agent": ChatPromptTemplate.from_messages([
              ("system", "You are a travel agent. Return JSON with keys: itinerary, notes."),
              ("human", "Plan a trip to {city} with a budget of {budget}.")
          ]),
          "smart_response": ChatPromptTemplate.from_messages([
              ("system", "You are a data assistant. Return ONLY valid JSON with keys: name, age, email, phone. Do not include any text outside the JSON."),
              ("human", "Generate person details for {person_name}, age {age}, email {email}, phone {phone}.")
          ])
      }

  def get_prompt(self, prompt_key, **kwargs):
      if prompt_key not in self.prompts:
          raise ValueError(f"Prompt '{prompt_key}' not found.")
      return self.prompts[prompt_key].invoke(kwargs)

pm = PromptManager()
  
# -------------------------------
# State and Models
# -------------------------------
class AgentState(TypedDict):
    task: str
    question: str
    city: str
    budget: str
    response: str
    person_name: str
    age: int
    email: str
    phone: str

class SupportResponse(BaseModel):
    steps: list[str]
    notes: str

class SmartResponse(BaseModel):
    name: str = Field(..., description="The name of a person.")
    age: int = Field(..., description="The age of a person.")
    email: str = Field(..., description="The email address of a person.")
    phone: str = Field(..., description="The phone number of a person.")

# -------------------------------
# Final Output (BaseModel)
# -------------------------------
class AgentOutput(BaseModel):
    task: str
    question: str
    city: str
    budget: str
    response: SmartResponse | SupportResponse

# -------------------------------
# Define Nodes
# -------------------------------

def support_system_node(state: AgentState) -> dict:
    """ Get support from prompt manager and invoke LLM. """
    prompt = pm.get_prompt("support system", question=state["question"])
    response = llm_openai.invoke(prompt)
    # Instruct LLM to return JSON
    # Example: {"steps": ["Step1", "Step2"], "notes": "Extra info"}
    try:
        data = json.loads(response.content)
    except:
        # fallback: wrap raw string
        data = {"steps": [response.content], "notes": "Unstructured output"}

    return {"response": data}

def travel_agent_node(state: AgentState) -> dict:
    """ Get travel plan from prompt manager and invoke LLM. """
    prompt = pm.get_prompt("travel_agent", city=state["city"], budget=state["budget"])
    response = llm_openai.invoke(prompt)
    # Instruct LLM to return JSON
    # Example: {"name": "John Doe", "age": 30, "email": "john.doe@example.com", "phone": "123-456-7890"}
    try:
        data = json.loads(response.content)
    except:
        # fallback: wrap raw string
        data = {"name": response.content, "age": 0, "email": "", "phone": ""}

    return {"response": data}

# -------------------------------
# Smart Response Node
# -------------------------------
def smart_response_node(state: AgentState) -> dict:
    prompt = pm.get_prompt(
        "smart_response",
        person_name=state["person_name"],
        age=state["age"],
        email=state["email"],
        phone=state["phone"]
    )
    response = llm_openai.invoke(prompt)

    try:
        data = json.loads(response.content)
    except Exception:
        data = {
            "name": state["person_name"],
            "age": state["age"],
            "email": state["email"],
            "phone": state["phone"]
        }

    return {"response": data}



# -------------------------------
# Build Graph
# -------------------------------
workflow = StateGraph(AgentState)
workflow.add_node("support_system", support_system_node)
workflow.add_node("travel_agent", travel_agent_node)
workflow.add_node("smart_response", smart_response_node)

# conditional branching which agent to invoke based on the task
def route_task(state: AgentState):
    if state["task"] == "support":
        return "support_system"
    elif state["task"] == "travel":
        return "travel_agent"
    elif state["task"] == "smart":
        return "smart_response"
    else:
        return END
    
# Use add_conditional_edges instead of add_edge
workflow.add_conditional_edges(
    START,
    route_task,
    {
        "support_system": "support_system",
        "travel_agent": "travel_agent",
        "smart_response": "smart_response",
        END: END
    }
)   
workflow.add_edge("support_system", END)
workflow.add_edge("travel_agent", END)
workflow.add_edge("smart_response", END)

# compile workflow to ensure all nodes and edges are valid
compiled_workflow = workflow.compile()

